rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner() {
      return request.auth != null
        && request.auth.token.email == 'kdystudy0426@gmail.com'
        && request.auth.token.firebase.sign_in_provider == 'password';
    }
    function validPage(page) {
      return page in ['index.html', 'archive.html', 'case-love-memory.html',
        'case-pr-apocalypse.html', 'case-pr-dirty-guilty.html',
        'case-pr-jam.html', 'case-pr-mimami.html'];
    }
    function validData() {
      return request.resource.data.keys().hasAll(['texts', 'revision', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['texts', 'revision', 'updatedAt'])
        && request.resource.data.texts is map
        && request.resource.data.texts.size() <= 2000
        && request.resource.data.revision is int
        && request.resource.data.updatedAt == request.time;
    }
    match /portfolioPages/{page} {
      allow get: if validPage(page);
      allow list: if false;
      allow create: if validPage(page) && owner() && validData()
        && request.resource.data.revision == 1;
      allow update: if validPage(page) && owner() && validData()
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }
  }
}
